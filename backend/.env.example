# Server Configuration
PORT=5000
JWT_SECRET=super_secret_web_slinger_jwt_key_2026

# ==============================================================
# 🍃 1. MongoDB Atlas Configuration (Free Database)
# ==============================================================
# Create a free cluster at: https://www.mongodb.com/cloud/atlas
# Example connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/questfolio?retryWrites=true&w=majority
MONGODB_URI=

# ==============================================================
# ☁️ 2. Cloudinary Configuration (Free Cloud Image Storage)
# ==============================================================
# Create a free account at: https://cloudinary.com
# Copy Cloud Name, API Key, and API Secret from your Cloudinary Dashboard:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=questfolio
